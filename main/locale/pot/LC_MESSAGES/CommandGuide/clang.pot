msgid ""
"Specify the compiler runtime library to use; supported options are libgcc "
"and compiler-rt. If not specified, platform default will be used."
msgstr ""

#: ../../../CommandGuide/clang.md:285
msgid "Same as -std=c89."
msgstr ""

