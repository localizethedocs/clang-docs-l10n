#: ../../../CommandGuide/diagtool.md:1
msgid "diagtool - clang diagnostics tool"
msgstr ""

#: ../../../CommandGuide/diagtool.md:3
msgid "SYNOPSIS"
msgstr ""

#: ../../../CommandGuide/diagtool.md:5
msgid "{program}`diagtool` *command* \\[*args*\\]"
msgstr ""

#: ../../../CommandGuide/diagtool.md:7
msgid "DESCRIPTION"
msgstr ""

#: ../../../CommandGuide/diagtool.md:9
msgid ""
"{program}`diagtool` is a combination of four tools for dealing with "
"diagnostics in {program}`clang`."
msgstr ""

#: ../../../CommandGuide/diagtool.md:11
msgid "SUBCOMMANDS"
msgstr ""

#: ../../../CommandGuide/diagtool.md:13
msgid ""
"{program}`diagtool` is separated into several subcommands each tailored to a "
"different purpose. A brief summary of each command follows, with more detail "
"in the sections that follow."
msgstr ""

#: ../../../CommandGuide/diagtool.md:17
msgid "{ref}`find_diagnostic_id` - Print the id of the given diagnostic."
msgstr ""

#: ../../../CommandGuide/diagtool.md:18
msgid "{ref}`list_warnings` - List warnings and their corresponding flags."
msgstr ""

#: ../../../CommandGuide/diagtool.md:19
msgid ""
"{ref}`show_enabled` - Show which warnings are enabled for a given command "
"line."
msgstr ""

#: ../../../CommandGuide/diagtool.md:20
msgid "{ref}`tree` - Show warning flags in a tree view."
msgstr ""

#: ../../../CommandGuide/diagtool.md:24
msgid "find-diagnostic-id"
msgstr ""

#: ../../../CommandGuide/diagtool.md:26
msgid "{program}`diagtool` find-diagnostic-id *diagnostic-name*"
msgstr ""

#: ../../../CommandGuide/diagtool.md:30
msgid "list-warnings"
msgstr ""

#: ../../../CommandGuide/diagtool.md:32
msgid "{program}`diagtool` list-warnings"
msgstr ""

#: ../../../CommandGuide/diagtool.md:36
msgid "show-enabled"
msgstr ""

#: ../../../CommandGuide/diagtool.md:38
msgid "{program}`diagtool` show-enabled \\[*options*\\] *filename ...*"
msgstr ""

#: ../../../CommandGuide/diagtool.md:42
msgid "tree"
msgstr ""

#: ../../../CommandGuide/diagtool.md:44
msgid "{program}`diagtool` tree \\[*diagnostic-group*\\]"
msgstr ""
