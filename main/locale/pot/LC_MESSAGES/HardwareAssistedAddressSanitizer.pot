#: ../../../HardwareAssistedAddressSanitizer.md:1
msgid "Hardware-assisted AddressSanitizer"
msgstr ""

#: ../../../HardwareAssistedAddressSanitizer.md:4
msgid "Introduction"
msgstr ""

#: ../../../HardwareAssistedAddressSanitizer.md:6
msgid ""
"Hardware-assisted AddressSanitizer (HWASan) is a memory error detector "
"similar to {doc}`AddressSanitizer`, but based on memory tagging and address "
"tagging (such as Top-Byte Ignore on AArch64). It provides similar bug "
"detection with significantly lower memory overhead (~10–20%)."
msgstr ""

#: ../../../HardwareAssistedAddressSanitizer.md:11
msgid "HWASan can detect:"
msgstr ""

#: ../../../HardwareAssistedAddressSanitizer.md:13
msgid ""
"Out-of-bounds accesses (heap, stack; globals tagging is not supported on all "
"platforms)"
msgstr ""

