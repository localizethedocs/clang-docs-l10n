msgid "VoidType"
msgstr ""

#: ../../../CIR/CIRDialect.md:16426
msgid "_CIR void type_"
msgstr ""

#: ../../../CIR/CIRDialect.md:16428
msgid "Syntax: `!cir.void`"
msgstr ""

#: ../../../CIR/CIRDialect.md:16430
msgid "The `!cir.void` type represents the C and C++ `void` type."
msgstr ""

