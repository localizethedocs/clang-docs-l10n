"i32 cases: 0, 1, 2, 3, 4, 5, 6, 7</td></tr>\n"
"</table>\n"
msgstr ""

#: ../../../CIR/CIRDialect.md:7501
msgid "`cir.insert_member` (::cir::InsertMemberOp)"
msgstr ""

#: ../../../CIR/CIRDialect.md:7503
msgid "_Overwrite the value of a member of a record value_"
msgstr ""

#: ../../../CIR/CIRDialect.md:7512
msgid ""
"The `cir.insert_member` operation overwrites the value of a particular "
"member in the input record, and returns the modified record. The result of "
"this operation is equal to the input record, except for the member specified "
"by `index_attr` whose value is equal to the given value."
msgstr ""

#: ../../../CIR/CIRDialect.md:7517
msgid "This operation is named after the LLVM instruction `insertvalue`."
msgstr ""

#: ../../../CIR/CIRDialect.md:7519
msgid "Currently `cir.insert_member` does not work on unions."
msgstr ""

