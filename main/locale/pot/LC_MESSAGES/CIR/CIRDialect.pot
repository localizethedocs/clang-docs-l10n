msgstr ""

#: ../../../CIR/CIRDialect.md:5979
msgid ""
"Computes the fused multiply-add of three floating-point values or vector."
msgstr ""

#: ../../../CIR/CIRDialect.md:5981 ../../../CIR/CIRDialect.md:6291
msgid ""
"The inputs must be either:   • floating-point scalar types, or   • vectors "
"whose element type is floating-point."
msgstr ""

#: ../../../CIR/CIRDialect.md:5985 ../../../CIR/CIRDialect.md:6295
#: ../../../CIR/CIRDialect.md:10645
msgid "The result type must match the input type exactly."
msgstr ""

#: ../../../CIR/CIRDialect.md:5987 ../../../CIR/CIRDialect.md:6297
#: ../../../CIR/CIRDialect.md:10647
