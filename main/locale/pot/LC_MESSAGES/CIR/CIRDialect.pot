msgid "Traits: `NoRegionArguments`, `SymbolName`, `SymbolVisibility`"
msgstr ""

#: ../../../CIR/CIRDialect.md:7090
msgid ""
"Interfaces: `CIRGlobalValueInterface`, `RegionBranchOpInterface`, `Symbol`"
msgstr ""

