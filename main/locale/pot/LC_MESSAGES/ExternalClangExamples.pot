msgid ""
"[https://github.com/exclipy/clang_indexer](https://github.com/exclipy/"
"clang_indexer)"
msgstr ""

#: ../../../ExternalClangExamples.md:68
msgid "\"This is an indexer for C and C++ based on the libclang library.\""
msgstr ""

#: ../../../ExternalClangExamples.md:70
msgid ""
"[https://github.com/holtgrewe/linty](https://github.com/holtgrewe/linty)"
msgstr ""

#: ../../../ExternalClangExamples.md:72
msgid "\"Linty - C/C++ Style Checking with Python & libclang.\""
msgstr ""

#: ../../../ExternalClangExamples.md:74
msgid "[https://github.com/axw/cmonster](https://github.com/axw/cmonster)"
msgstr ""

#: ../../../ExternalClangExamples.md:76
msgid "\"cmonster is a Python wrapper for the Clang C++ parser.\""
msgstr ""

#: ../../../ExternalClangExamples.md:78
msgid ""
"[https://github.com/rizsotto/Constantine](https://github.com/rizsotto/"
"Constantine)"
msgstr ""

#: ../../../ExternalClangExamples.md:80
msgid ""
"\"Constantine is a toy project to learn how to write clang plugin. "
"Implements pseudo const analysis. Generates warnings about variables, which "
"were declared without const qualifier.\""
msgstr ""

#: ../../../ExternalClangExamples.md:84
msgid "[https://github.com/jessevdk/cldoc](https://github.com/jessevdk/cldoc)"
msgstr ""

#: ../../../ExternalClangExamples.md:86
msgid ""
"\"cldoc is a Clang based documentation generator for C and C++. cldoc tries "
"to solve the issue of writing C/C++ software documentation with a modern, "
"non-intrusive and robust approach.\""
msgstr ""

#: ../../../ExternalClangExamples.md:90
msgid ""
"[https://github.com/AlexDenisov/ToyClangPlugin](https://github.com/"
"AlexDenisov/ToyClangPlugin)"
msgstr ""

#: ../../../ExternalClangExamples.md:92
msgid ""
"\"The simplest Clang plugin implementing a semantic check for Objective-C. "
"This example shows how to use the `DiagnosticsEngine` (emit warnings, "
"errors, fixit hints). See also [http://l.rw.rw/clang_plugin](http://l.rw.rw/"
"clang_plugin) for step-by-step instructions.\""
msgstr ""

#: ../../../ExternalClangExamples.md:97
msgid ""
"[https://phabricator.kde.org/source/clazy](https://phabricator.kde.org/"
"source/clazy)"
msgstr ""

#: ../../../ExternalClangExamples.md:99
msgid ""
"\"clazy is a compiler plugin which allows clang to understand Qt semantics. "
"You get more than 50 Qt related compiler warnings, ranging from unneeded "
"memory allocations to misusage of API, including fix-its for automatic "
"refactoring.\""
msgstr ""

#: ../../../ExternalClangExamples.md:104
msgid ""
"[https://gerrit.libreoffice.org/gitweb?p=core.git;a=blob_plain;"
"f=compilerplugins/README;hb=HEAD](https://gerrit.libreoffice.org/gitweb?"
"p=core.git;a=blob_plain;f=compilerplugins/README;hb=HEAD)"
msgstr ""

#: ../../../ExternalClangExamples.md:106
msgid ""
"\"LibreOffice uses a Clang plugin infrastructure to check during the build "
"various things, some more, some less specific to the LibreOffice source "
"code. There are currently around 50 such checkers, from flagging C-style "
"casts and uses of reserved identifiers to ensuring that code adheres to "
"lifecycle protocols for certain LibreOffice-specific classes. They may serve "
"as examples for writing RecursiveASTVisitor-based plugins.\""
msgstr ""

