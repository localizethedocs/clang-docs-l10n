msgid ""
"**BreakBeforeInlineASMColon** (`BreakBeforeInlineASMColonStyle`) "
"{versionbadge}`clang-format 16` {ref}`¶ <BreakBeforeInlineASMColon>`"
msgstr ""

#: ../../../ClangFormatStyleOptions.md:3728
msgid "The inline ASM colon style to use."
msgstr ""

