msgid ""
"**BreakAfterOpenBracketIf** (`Boolean`) {versionbadge}`clang-format 22` {ref}"
"`¶ <BreakAfterOpenBracketIf>`"
msgstr ""

#: ../../../ClangFormatStyleOptions.md:2940
msgid ""
"Force break after the left parenthesis of an if control statement when the "
"expression exceeds the column limit."
msgstr ""

#: ../../../ClangFormatStyleOptions.md:2951
msgid ""
"**BreakAfterOpenBracketLoop** (`Boolean`) {versionbadge}`clang-format 22` "
"{ref}`¶ <BreakAfterOpenBracketLoop>`"
msgstr ""

#: ../../../ClangFormatStyleOptions.md:2953
msgid ""
"Force break after the left parenthesis of a loop control statement when the "
"expression exceeds the column limit."
msgstr ""

#: ../../../ClangFormatStyleOptions.md:2964
msgid ""
"**BreakAfterOpenBracketSwitch** (`Boolean`) {versionbadge}`clang-format 22` "
"{ref}`¶ <BreakAfterOpenBracketSwitch>`"
msgstr ""

#: ../../../ClangFormatStyleOptions.md:2966
msgid ""
"Force break after the left parenthesis of a switch control statement when "
"the expression exceeds the column limit."
msgstr ""

#: ../../../ClangFormatStyleOptions.md:2977
msgid ""
"**BreakAfterReturnType** (`ReturnTypeBreakingStyle`) {versionbadge}`clang-"
"format 19` {ref}`¶ <BreakAfterReturnType>`"
msgstr ""

#: ../../../ClangFormatStyleOptions.md:2979
msgid "The function declaration return type breaking style to use."
msgstr ""

#: ../../../ClangFormatStyleOptions.md:2983
msgid ""
"`RTBS_None` (in configuration: `None`) This is **deprecated**. See "
"`Automatic` below."
msgstr ""

#: ../../../ClangFormatStyleOptions.md:2986
msgid ""
"`RTBS_Automatic` (in configuration: `Automatic`) Break after return type "
"based on `PenaltyReturnTypeOnItsOwnLine`."
msgstr ""

