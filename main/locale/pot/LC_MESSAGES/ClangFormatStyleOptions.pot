#: ../../../ClangFormatStyleOptions.md:3775
msgid ""
"`BBRTS_All` (in configuration: `All`) Always break before the return type."
msgstr ""

#: ../../../ClangFormatStyleOptions.md:3783
msgid ""
"`BBRTS_TopLevel` (in configuration: `TopLevel`) Break before the return type "
"of top-level functions only."
msgstr ""

#: ../../../ClangFormatStyleOptions.md:3786
msgid ""
"`BBRTS_AllDefinitions` (in configuration: `AllDefinitions`) Break before the "
"return type of function definitions only."
msgstr ""

#: ../../../ClangFormatStyleOptions.md:3789
msgid ""
"`BBRTS_TopLevelDefinitions` (in configuration: `TopLevelDefinitions`) Break "
"before the return type of top-level definitions only."
msgstr ""

