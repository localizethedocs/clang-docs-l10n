msgid ""
"**BreakBeforeCloseBracketIf** (`Boolean`) {versionbadge}`clang-format 22` "
"{ref}`¶ <BreakBeforeCloseBracketIf>`"
msgstr ""

#: ../../../ClangFormatStyleOptions.md:3649
msgid ""
"Force break before the right parenthesis of an if control statement when the "
"expression exceeds the column limit. The break before the closing "
"parenthesis is only made if there is a break after the opening parenthesis."
msgstr ""

#: ../../../ClangFormatStyleOptions.md:3663
msgid ""
"**BreakBeforeCloseBracketLoop** (`Boolean`) {versionbadge}`clang-format 22` "
"{ref}`¶ <BreakBeforeCloseBracketLoop>`"
msgstr ""

#: ../../../ClangFormatStyleOptions.md:3665
msgid ""
"Force break before the right parenthesis of a loop control statement when "
"the expression exceeds the column limit. The break before the closing "
"parenthesis is only made if there is a break after the opening parenthesis."
msgstr ""

#: ../../../ClangFormatStyleOptions.md:3679
msgid ""
"**BreakBeforeCloseBracketSwitch** (`Boolean`) {versionbadge}`clang-format "
"22` {ref}`¶ <BreakBeforeCloseBracketSwitch>`"
msgstr ""

#: ../../../ClangFormatStyleOptions.md:3681
msgid ""
"Force break before the right parenthesis of a switch control statement when "
"the expression exceeds the column limit. The break before the closing "
"parenthesis is only made if there is a break after the opening parenthesis."
msgstr ""

#: ../../../ClangFormatStyleOptions.md:3695
msgid ""
"**BreakBeforeConceptDeclarations** (`BreakBeforeConceptDeclarationsStyle`) "
"{versionbadge}`clang-format 12` {ref}`¶ <BreakBeforeConceptDeclarations>`"
