msgstr ""

#: ../../../AttributeReference.md:484 ../../../AttributeReference.md:530
msgid ""
"Specified values are not compatible with values provided through other "
"attributes."
msgstr ""

#: ../../../AttributeReference.md:488
msgid "amdgpu_max_num_work_groups"
msgstr ""

#: ../../../AttributeReference.md:501
msgid "`amdgpu_max_num_work_groups`"
msgstr ""

#: ../../../AttributeReference.md:502
msgid "`clang::amdgpu_max_num_work_groups`"
msgstr ""

#: ../../../AttributeReference.md:511
msgid ""
"This attribute specifies the max number of work groups when the kernel is "
"dispatched."
msgstr ""

#: ../../../AttributeReference.md:514
msgid ""
"Clang supports the `__attribute__((amdgpu_max_num_work_groups(<x>, <y>, "
"<z>)))` or `[[clang::amdgpu_max_num_work_groups(<x>, <y>, <z>)]]` attribute "
"for the AMDGPU target. This attribute may be attached to HIP or OpenCL "
"kernel function definitions and is an optimization hint."
msgstr ""

#: ../../../AttributeReference.md:520
msgid ""
"The `<x>` parameter specifies the maximum number of work groups in the x "
"dimension. Similarly `<y>` and `<z>` are for the y and z dimensions "
"respectively. Each of the three values must be greater than 0 when provided. "
"The `<x>` parameter is required, while `<y>` and `<z>` are optional with "
"default value of 1."
msgstr ""

#: ../../../AttributeReference.md:525
msgid ""
"If specified, the AMDGPU target backend might be able to produce better "
"machine code."
msgstr ""

