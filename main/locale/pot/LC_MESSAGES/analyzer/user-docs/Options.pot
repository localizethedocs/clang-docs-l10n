msgid ""
"Accepted values: \"dfs\", \"bfs\", \"unexplored\\_first\", "
"\"unexplored\\_first\\_queue\", \"unexplored\\_first\\_location\\_queue\", "
"\"bfs\\_block\\_dfs\\_contents\"."
msgstr ""

#: ../../../analyzer/user-docs/Options.rst:909
msgid "Default value: \"unexplored_first_queue\""
msgstr ""

