msgid "0x0010"
msgstr ""

#: ../../../LanguageExtensions.md:60
msgid "Negative subnormal"
msgstr ""

#: ../../../LanguageExtensions.md:60
msgid "\\_\\_FPCLASS_NEGSUBNORMAL"
msgstr ""

#: ../../../LanguageExtensions.md:60
