msgid "``__builtin_amdgcn_cvt_scale_pk32_f32_fp6``"
msgstr ""

#: ../../../AMDGPUBuiltinReference.rst:599
msgid ""
"Converts 32 packed 6-bit float values in ``src`` to single-precision "
"float32, then multiplies each result by a shared block-scale factor."
msgstr ""

#: ../../../AMDGPUBuiltinReference.rst:614
msgid "``__builtin_amdgcn_cvt_scalef32_pk32_bf6_f32``"
msgstr ""

