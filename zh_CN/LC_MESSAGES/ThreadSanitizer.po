msgid "Configuration Options"
msgstr ""

#: ../../../ThreadSanitizer.md:371
msgid "Adaptive Delay Options"
msgstr ""

#: ../../../ThreadSanitizer.md:376
msgid "Flag"
msgstr ""

#: ../../../ThreadSanitizer.md:377
msgid "Type"
msgstr ""

#: ../../../ThreadSanitizer.md:378
msgid "Default"
msgstr ""

#: ../../../ThreadSanitizer.md:379
msgid "Description"
msgstr ""

#: ../../../ThreadSanitizer.md:380
msgid "`enable_adaptive_delay`"
msgstr ""

#: ../../../ThreadSanitizer.md:381
msgid "bool"
msgstr ""

#: ../../../ThreadSanitizer.md:382
msgid "false"
msgstr ""

#: ../../../ThreadSanitizer.md:383
msgid "Enable adaptive delay injection to expose data races."
msgstr ""

#: ../../../ThreadSanitizer.md:384
msgid "`adaptive_delay_aggressiveness`"
msgstr ""

#: ../../../ThreadSanitizer.md:385 ../../../ThreadSanitizer.md:392
#: ../../../ThreadSanitizer.md:397 ../../../ThreadSanitizer.md:403
msgid "int"
msgstr ""

#: ../../../ThreadSanitizer.md:386
msgid "25"
msgstr ""

#: ../../../ThreadSanitizer.md:387
msgid ""
"Controls delay injection intensity for race detection. Higher values inject "
"more delays to expose races. Value must be greater than 0. Suggested values: "
"10 (minimal), 50 (moderate), 200 (aggressive). This is a tuning parameter; "
"actual overhead varies by workload and platform."
msgstr ""

#: ../../../ThreadSanitizer.md:391
msgid "`adaptive_delay_relaxed_sample_rate`"
msgstr ""

#: ../../../ThreadSanitizer.md:393
msgid "10000"
msgstr ""

#: ../../../ThreadSanitizer.md:394
msgid ""
"Sample 1 in N relaxed atomic operations for delay injection. Relaxed atomics "
"have minimal synchronization, so sampling helps avoid excessive overhead."
msgstr ""

#: ../../../ThreadSanitizer.md:396
msgid "`adaptive_delay_sync_atomic_sample_rate`"
msgstr ""

#: ../../../ThreadSanitizer.md:398
msgid "100"
msgstr ""

#: ../../../ThreadSanitizer.md:399
msgid ""
"Sample 1 in N acquire/release/seq_cst atomic operations for delay injection. "
"These synchronizing atomics are more likely to expose races, so are sampled "
"more often."
msgstr ""

#: ../../../ThreadSanitizer.md:402
msgid "`adaptive_delay_mutex_sample_rate`"
msgstr ""

#: ../../../ThreadSanitizer.md:404
msgid "10"
msgstr ""

#: ../../../ThreadSanitizer.md:405
msgid ""
"Sample 1 in N mutex/condition variable operations for delay injection. Mutex "
"ops are high-value synchronization points and are sampled frequently."
msgstr ""

#: ../../../ThreadSanitizer.md:407
msgid "`adaptive_delay_max_atomic`"
msgstr ""

#: ../../../ThreadSanitizer.md:408 ../../../ThreadSanitizer.md:415
msgid "string"
msgstr ""

#: ../../../ThreadSanitizer.md:409
msgid "`\"sleep_us=50\"`"
msgstr ""

#: ../../../ThreadSanitizer.md:410
msgid ""
"Maximum delay for atomic operations. Format: `\"spin=N\"` (N spin cycles, 1 "
"<= N <= 10,000), `\"yield\"` (one yield to the OS), or `\"sleep_us=N\"` (up "
"to N microseconds). The delay is randomly chosen up to the specified maximum "
"N."
msgstr ""

#: ../../../ThreadSanitizer.md:414
msgid "`adaptive_delay_max_sync`"
msgstr ""

#: ../../../ThreadSanitizer.md:416
msgid "`\"sleep_us=500\"`"
msgstr ""

#: ../../../ThreadSanitizer.md:417
msgid ""
"Maximum delay for synchronization operations (mutex and thread lifecycle "
"operations). Format: same as `adaptive_delay_max_atomic`. Typically set "
"longer than atomic delays since these operations involve waking blocked "
"threads and may be more likely to expose races."
msgstr ""

